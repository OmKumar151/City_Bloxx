  tutorials:
  - tutorialId: WELCOME
    displayName: Welcome
    steps:
    - title: WELCOME TO CITY BLOXX!
      message: 'Welcome to City Bloxx!


        Build your city, place buildings,

        and
        grow your city to achieve the

        highest score possible.'
      targetId: 
      showHighlight: 0
    - title: GROW YOUR CITY
      message: Choose buildings, place them on valid locations, and increase your
        population to unlock more of the city.
      targetId: 
      showHighlight: 0
  - tutorialId: BUILDING_SELECTION
    displayName: Building Selection
    steps:
    - title: CHOOSE YOUR BUILDING
      message: Select a building to add it to your city. Different buildings have
        different placement requirements.
      targetId: BuildingSelection
      showHighlight: 1
    - title: UNLOCK MORE BUILDINGS
      message: Grow your population to unlock additional buildings and rewards. Locked
        buildings become available when you reach their requirements.
      targetId: 
      showHighlight: 0
  mainMenuSceneName: Main Menu
  levelSelectSceneName: LevelSelect
  tutorialPanel: {fileID: 0}
  pauseGameWhileTutorialIsOpen: 1
